SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
PYTHONPATH=/app/Skuld

# Run data collection with timeout and lock protection

#############################################################################################
# Option Data: Montag bis Freitag, alle 30 Minuten von 08:00 bis 21:00 UTC (09:00–22:00 MEZ)
0,30 8-20 * * 1-5 /bin/bash /app/Skuld/run_data_collection.sh option_data

# Saturday Night: Samstag, 21:00 UTC (22:00 MEZ)
0 21 * * 6 /bin/bash /app/Skuld/run_data_collection.sh saturday_night

# Marked Start/Mid/End: Montag bis Freitag, 09:15, 14:15, 19:15 UTC (10:15, 15:15, 20:15 MEZ)
15 9,14,19 * * 1-5 /bin/bash /app/Skuld/run_data_collection.sh market_start_mid_end

# Stock Data Daily: Montag bis Freitag, 09:45 UTC (10:45 MEZ)
45 9 * * 1-5 /bin/bash /app/Skuld/run_data_collection.sh stock_data_daily

# Historization: Montag bis Freitag, 21:30 UTC (22:30 MEZ)
30 21 * * 1-5 /bin/bash /app/Skuld/run_data_collection.sh historization

# Job-Dispatcher (SM37-Queue): jede Minute die geplanten Jobs unter logs/_queue/ pruefen
# und faellige starten. Sicherheitsnetz statt Sofort-Feuer per Admin-Button.
* * * * * cd /app/Skuld && /usr/local/bin/python -m src.job_dispatcher >> /var/log/cron_dispatcher.log 2>&1

#############################################################################################
# Log Cleanup: Taeglich um 03:00 UTC - Logs aelter als 14 Tage loeschen
# (logs/_queue ausgenommen: ein weit in der Zukunft geplanter Job darf nicht geloescht werden)
0 3 * * * find /app/Skuld/logs -type f -mtime +14 -not -path "*/_queue/*" -delete && find /app/Skuld/logs -type d -empty -not -path "*/_queue*" -delete

# Watchlist Daily Backup: Taeglich um 02:00 UTC - Sicherung unabhaengig vom User-Save
0 2 * * * mkdir -p /app/Skuld/data/backups && cp /app/Skuld/data/watchlist.xlsx /app/Skuld/data/backups/watchlist_daily_$(date +\%Y\%m\%d).xlsx 2>/dev/null

# Watchlist Backup Cleanup: Taeglich um 03:05 UTC - Backups aelter als 3 Tage loeschen
5 3 * * * find /app/Skuld/data/backups -name "watchlist_*.xlsx" -mtime +3 -delete 2>/dev/null
